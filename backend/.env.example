# SmartClinic server
PORT=5180
CORS_ORIGIN=http://localhost:5180

# Microsoft SQL Server
DB_HOST=localhost
DB_PORT=1433
# Named instance (e.g. SQLEXPRESS) – leave empty to use DB_PORT
DB_INSTANCE=
DB_USER=sa
DB_PASSWORD=
DB_NAME=T_multi_branch
# Encrypted connection; trust the server's own certificate (typical for self-hosted SQL Server)
DB_ENCRYPT=true
DB_TRUST_CERT=true

# Use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Clinic local time (India = 330 minutes ahead of UTC)
APP_TZ=Asia/Kolkata
TZ_OFFSET_MINUTES=330

# First Super Admin created by the setup step
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=ChangeMe@123
SEED_ADMIN_NAME=Super Admin
# 1 = also create demo clinics Clinic A (CLA) and Clinic B (CLB)
SEED_DEMO=1
