PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5180

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smartclinic

# Use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Clinic local time zone (queue dates, "today" totals)
APP_TZ=Asia/Kolkata
DB_TIME_ZONE=+05:30

# First Super Admin created by `npm run seed`
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=ChangeMe@123
SEED_ADMIN_NAME=Super Admin
# Set to 1 to also create demo clinics Clinic A (CLA) and Clinic B (CLB)
SEED_DEMO=1
